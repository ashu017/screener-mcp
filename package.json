{
  "name": "screener-mcp",
  "version": "0.2.0",
  "description": "MCP server exposing Screener.in Indian-stock fundamentals, financials, peers, and price/EPS trends.",
  "type": "module",
  "bin": {
    "screener-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "screener",
    "india",
    "nse",
    "bse",
    "stocks",
    "fundamentals"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashu017/screener-mcp.git"
  },
  "homepage": "https://github.com/ashu017/screener-mcp#readme",
  "bugs": "https://github.com/ashu017/screener-mcp/issues",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-html-parser": "^7.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
